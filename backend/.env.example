# ---- Server ----
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ---- Postgres ----
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox_scheduler?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ---- Ethereal (fake SMTP) ----
# Leave blank to auto-generate N Ethereal test accounts on boot (see SENDER_COUNT).
# Or provide a comma-separated list of pre-created Ethereal creds as JSON (see README).
ETHEREAL_AUTO_CREATE=true
SENDER_COUNT=2

# ---- Real Gmail SMTP (optional) ----
# Leave both blank to keep using Ethereal fake SMTP (nothing is delivered to real inboxes).
# Set both to send real email via Gmail. GMAIL_APP_PASSWORD must be a Google App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords), NOT your normal
# Gmail password — Google blocks plain-password SMTP login.
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# ---- Scheduler tuning (all configurable, no hardcoding) ----
# Minimum delay between individual email sends, in milliseconds (global worker throttle)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Worker concurrency (number of jobs processed in parallel by one worker process)
WORKER_CONCURRENCY=5
# Max emails sent per sender per rolling hour window
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# How often (ms) the reconciliation sweep re-enqueues any DB rows missing from the queue
RECONCILE_INTERVAL_MS=60000
